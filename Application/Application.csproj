<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MediatR" Version="12.4.0" />
		<PackageReference Include="FluentValidation" Version="11.9.2" />
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.2" />
		<!-- Include/Where/AsNoTracking/ToListAsync already reach Application transitively
		     through Domain's own (Index-attribute-only) EF Core reference. AsSplitQuery is
		     relational-provider-specific and lives in this package instead of the base one,
		     so it needs an explicit reference. Version matches Persistence/API. -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.6" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Domain\Domain.csproj" />
	</ItemGroup>

	<!-- Test projects need to reach internal helpers (e.g. GroupOrderOrderBuilder). -->
	<ItemGroup>
		<InternalsVisibleTo Include="Application.UnitTests" />
		<InternalsVisibleTo Include="API.IntegrationTests" />
	</ItemGroup>
</Project>