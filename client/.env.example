# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored, so your keys stay out of source control.

# Geoapify API key — powers address autocomplete on the order form.
# Get a free key at https://myprojects.geoapify.com/ (free tier).
# If this is left blank, the address fields fall back to a plain text input.
VITE_GEOAPIFY_API_KEY=
